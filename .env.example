# Copy to `.env` (local) or `/etc/ruyi/ruyi.env` (server). Never commit real values.
# `npm run api` loads `.env` automatically.

# ---------- Frontend (Vite) ----------
# Leave empty in local development to use the Vite proxy.
VITE_API_BASE_URL=
RUYI_API_TARGET=http://127.0.0.1:8787

# ---------- API server ----------
NODE_ENV=development
HOST=127.0.0.1
RUYI_API_PORT=8787
# SQLite file. Back it up daily: `npm run db:backup`.
DATABASE_PATH=data/ruyi.db
STORE_TIMEZONE=Asia/Shanghai
# Set to 1 only when running behind nginx (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# Browser origins allowed to call the API if the merchant admin is hosted on
# another domain, comma separated. Not needed for the mini-program.
ALLOWED_ORIGINS=
# Unpaid orders are closed and cancelled after this many minutes.
ORDER_PAY_TIMEOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=30
# Create the demo user/coupons on first start (defaults to on in mock auth mode).
SEED_DEMO=

# ---------- Merchant admin ----------
# Optional bootstrap: creates this admin on start if it doesn't exist.
# Prefer `npm run admin:create -- <username>` (prompts for the password).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_SECONDS=43200

# ---------- WeChat login ----------
# mock: any code logs in as the demo user (development only).
WECHAT_AUTH_MODE=mock
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_AUTH_TTL_SECONDS=604800
# Only for local mock tests.
MOCK_WECHAT_PHONE=15805320100

# ---------- WeChat Pay API v3 ----------
# mock: /pay marks orders paid immediately (development only).
PAYMENT_MODE=mock
WECHATPAY_MCHID=
# Serial number of the merchant API certificate (商户API证书序列号).
WECHATPAY_CERT_SERIAL=
# apiclient_key.pem downloaded from the WeChat Pay merchant platform.
WECHATPAY_PRIVATE_KEY_PATH=
# 32-byte APIv3 key set in the merchant platform.
WECHATPAY_APIV3_KEY=
# "微信支付公钥" ID (PUB_KEY_ID_...) and the public key file.
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
# Public HTTPS URL of POST /api/pay/notify.
WECHATPAY_NOTIFY_URL=https://api.example.com/api/pay/notify
WECHATPAY_REFUND_NOTIFY_URL=

# Production refuses mock login/payment unless explicitly allowed (internal tests only).
ALLOW_MOCK_IN_PRODUCTION=0
