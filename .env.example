# Frontend API base. Leave empty in local development to use the Vite proxy.
VITE_API_BASE_URL=

# Optional Vite proxy target if the API runs on another local host/port.
RUYI_API_TARGET=http://127.0.0.1:8787

# Used by `npm run api` when no PORT is supplied.
RUYI_API_PORT=8787

# Server-only WeChat authorization settings. Keep these out of Vite/client
# variables and never commit the real secret.
WECHAT_AUTH_MODE=mock
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_AUTH_TTL_SECONDS=7200
# Only for local mock tests; do not use in production.
MOCK_WECHAT_PHONE=15805320100

