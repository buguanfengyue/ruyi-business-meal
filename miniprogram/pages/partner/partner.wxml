<view wx:if="{{!data}}" class="empty">加载中…</view>
<block wx:else>
  <view class="rules">{{data.rules}}</view>
  <view class="card-dark"><view class="avatar">👤</view><text class="badge">共享合伙人</text><text class="rule-link" bindtap="showRules">规则 ›</text></view>
  <view class="money">
    <view class="money-main"><view class="big">{{data.text.withdrawable}}</view><view class="label">可提现佣金 (元)</view></view>
    <button class="btn-outline" bindtap="invite">邀请好友</button>
    <button class="btn-solid" bindtap="withdraw">提现</button>
  </view>
  <view class="stats">
    <view><view class="bold">{{data.text.total}}</view><view class="label">总收益(元)</view></view>
    <view><view class="bold">{{data.text.pending}}</view><view class="label">待结算(元)</view></view>
    <view bindtap="income"><view class="bold">查看</view><view class="label">收入明细 ▸</view></view>
  </view>
  <view class="list">
    <view class="seg"><view class="{{tab === 0 ? 'on' : ''}}" data-tab="0" bindtap="pickTab">已邀请 {{data.invited.length}} 人</view><view class="{{tab === 1 ? 'on' : ''}}" data-tab="1" bindtap="pickTab">失效 {{data.invalid.length}} 人</view></view>
    <view class="thead"><text>全部粉丝</text><text>累计佣金</text><text>邀请时间</text></view>
    <view wx:for="{{rows}}" wx:key="invitedAt" class="trow"><text>{{item.nickname}}</text><text>¥{{item.commissionText}}</text><text>{{item.timeText}}</text></view>
    <view wx:if="{{!rows.length}}" class="empty small-empty"><view class="empty-art">🗂️</view>暂无数据</view>
  </view>
</block>
