page { background: #fff; }
.rules { background: #fdeee2; color: #555; font-size: 26rpx; line-height: 1.75; padding: 16rpx 28rpx; }
.card-dark { margin: 44rpx 36rpx 0; height: 112rpx; background: linear-gradient(90deg, #3a3a3a, #555); display: flex; align-items: center; padding: 0 32rpx; gap: 32rpx; border-radius: 8rpx 8rpx 0 0; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #eee; text-align: center; line-height: 76rpx; }
.badge { background: #f3d9a4; color: #5a4320; font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 6rpx; }
.rule-link { margin-left: auto; color: #e9cf9b; font-size: 30rpx; }
.money { display: flex; align-items: center; gap: 24rpx; padding: 40rpx 36rpx 0; }
.money-main { flex: 1; }
.big { font-size: 64rpx; font-weight: 700; margin-bottom: 12rpx; }
.money button { margin: 0; height: 80rpx; line-height: 80rpx; padding: 0 36rpx; border-radius: 40rpx; font-size: 30rpx; }
.btn-outline { background: #fff; color: #555; border: 1rpx solid #eee; }
.btn-solid { background: #d91e26; color: #fff; }
.stats { display: flex; padding: 52rpx 36rpx 36rpx; border-bottom: 16rpx solid #f5f5f5; }
.stats > view { flex: 1; }
.bold { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.list { padding: 32rpx 36rpx; }
.seg { display: flex; border: 4rpx solid #d91e26; border-radius: 16rpx; background: #d91e26; overflow: hidden; }
.seg view { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.seg view.on { background: #fff; color: #d91e26; }
.thead, .trow { display: flex; padding: 28rpx 16rpx; font-size: 28rpx; }
.thead text, .trow text { flex: 1; }
.thead text:first-child, .trow text:first-child { flex: 1.6; }
.thead { font-weight: 700; }
.trow { border-top: 1rpx solid #f3f3f3; color: #555; font-size: 26rpx; }
.small-empty { padding: 60rpx 0; }
.empty-art { font-size: 100rpx; opacity: .5; }
