.hero { height: 600rpx; background: linear-gradient(160deg, #3b3fd0, #5a2fc0 60%, #3a2aa8); position: relative; }
.art { position: absolute; top: 60rpx; width: 100%; text-align: center; font-size: 140rpx; }
.call { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 400rpx; background: #fff; border-radius: 12rpx 12rpx 0 0; padding: 28rpx 0 8rpx; text-align: center; font-size: 44rpx; line-height: 1.2; }
.c1 { font-weight: 800; letter-spacing: 12rpx; }
.c2 { font-weight: 800; letter-spacing: 12rpx; color: #11b04a; font-size: 52rpx; }
.panel { background: #fff; margin: 0 20rpx 24rpx; border-radius: 12rpx; padding: 32rpx 28rpx; }
.share { background: #07c160; color: #fff; border-radius: 6rpx; font-size: 34rpx; }
.h { font-size: 30rpx; margin: 44rpx 0 28rpx; }
.coupon { display: flex; align-items: center; border: 1rpx solid #d9a3a3; background: #fff8f6; border-radius: 12rpx; height: 220rpx; }
.left { width: 240rpx; height: 112rpx; border-right: 1rpx dashed #d98a8a; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; }
.amt { color: #d91e26; font-size: 56rpx; }
.yen { font-size: 26rpx; }
.tiny { font-size: 22rpx; color: #666; }
.right { padding-left: 40rpx; display: flex; flex-direction: column; gap: 20rpx; font-size: 30rpx; }
.seg { display: flex; border: 4rpx solid #d91e26; border-radius: 16rpx; background: #d91e26; overflow: hidden; }
.seg view { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; color: #fff; font-size: 28rpx; border-radius: 12rpx; }
.seg view.on { background: #fff; color: #d91e26; }
.trow { display: flex; justify-content: space-between; padding: 24rpx 8rpx; border-bottom: 1rpx solid #f3f3f3; font-size: 26rpx; }
.small-empty { padding: 60rpx 0; }
