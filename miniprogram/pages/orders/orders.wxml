<view wx:if="{{needLogin}}" class="empty">
  <view>登录后查看订单</view>
  <button class="btn-red" bindtap="goAuth">去登录</button>
</view>
<block wx:else>
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id" class="tab {{active === index ? 'active' : ''}}" data-index="{{index}}" bindtap="pickTab">{{item.label}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <button bindtap="load">点击重试</button>
  </view>
  <view wx:elif="{{filtered.length}}" class="list">
    <view wx:for="{{filtered}}" wx:key="id" class="card order" data-id="{{item.id}}" bindtap="open">
      <view class="head"><text class="bold">如一商务餐</text><text class="status-{{item.status}}">{{item.statusText}}</text></view>
      <view class="summary">{{item.summary}}</view>
      <view class="foot"><text>{{item.timeText}}</text><text>共{{item.count}}件 实付<text class="bold big">¥{{item.totalText}}</text></text></view>
    </view>
  </view>
  <view wx:else class="empty">
    <image class="empty-img" src="/images/empty/orders.png" mode="aspectFit" />
    <view>您当前还没有订单</view>
    <button bindtap="goMenu">去点单</button>
  </view>
</block>
