page { background: #fff; }
.profile { display: flex; align-items: center; gap: 20rpx; padding: 40rpx 48rpx; }
.avatar { width: 132rpx; height: 132rpx; border-radius: 50%; background: #f3f3f3; }
.profile-main { flex: 1; }
.name { font-size: 40rpx; font-weight: 700; margin-bottom: 10rpx; }
.hint { font-size: 26rpx; }
.member { margin: 0 32rpx; background: #3f3a37; color: #d9c8b0; height: 84rpx; border-radius: 16rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; }
.member-left { display: flex; align-items: center; gap: 12rpx; }
.member-badge { width: 36rpx; height: 36rpx; }
.member-more { font-size: 26rpx; }
.list { border-top: 1rpx solid #eee; margin-top: 24rpx; }
.row { height: 120rpx; padding: 0 40rpx; border-bottom: 1rpx solid #eee; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; box-sizing: border-box; }
.row.danger { color: #d91e26; }
.row-left { display: flex; align-items: center; gap: 20rpx; }
.row-icon { width: 40rpx; height: 40rpx; }
.register { text-align: center; }
.register-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto 20rpx; background: #282522; display: block; }
.register-title { font-size: 38rpx; font-weight: 700; margin-bottom: 10rpx; }
.register-input { border: 1rpx solid #eee; border-radius: 10rpx; height: 88rpx; padding: 0 24rpx; text-align: left; margin: 30rpx 0 24rpx; }
.skip { color: #999; padding: 24rpx; }
