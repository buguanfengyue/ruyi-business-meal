page { background: #fff; }
.profile { display: flex; align-items: center; gap: 20rpx; padding: 40rpx 48rpx; }
.avatar { width: 132rpx; height: 132rpx; border-radius: 50%; background: linear-gradient(135deg, #e6b989, #d33d27); color: #fff; font-size: 52rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.profile-main { flex: 1; }
.name { font-size: 40rpx; font-weight: 700; margin-bottom: 10rpx; }
.hint { font-size: 26rpx; }
.member { margin: 0 32rpx; background: #3f3a37; color: #d9c8b0; height: 84rpx; border-radius: 16rpx 16rpx 0 0; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; }
.member-more { font-size: 26rpx; }
.balance { position: relative; padding: 30rpx 40rpx 40rpx; }
.balance-num { font-size: 62rpx; font-weight: 700; margin-top: 12rpx; }
.recharge { position: absolute; right: 40rpx; top: 96rpx; border: 1rpx solid #cdb99b; color: #c7a980; border-radius: 34rpx; padding: 10rpx 40rpx; }
.list { border-top: 1rpx solid #eee; }
.row { height: 120rpx; padding: 0 40rpx; border-bottom: 1rpx solid #eee; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; }
.register { text-align: center; }
.register-title { font-size: 38rpx; font-weight: 700; margin-bottom: 10rpx; }
.register-input { border: 1rpx solid #eee; border-radius: 10rpx; height: 88rpx; padding: 0 24rpx; text-align: left; margin: 30rpx 0 24rpx; }
.skip { color: #999; padding: 24rpx; }
