<view wx:if="{{needLogin}}" class="empty">
  <view>登录后查看预约</view>
  <button class="btn-red" bindtap="goAuth">去登录</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>
<view wx:elif="{{error}}" class="empty">
  <view>{{error}}</view>
  <button class="btn-red" bindtap="load">点击重试</button>
</view>
<view wx:elif="{{orders.length}}" class="list">
  <view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
    <view class="line"><text class="bold">预约 {{item.schedule}}</text><text class="red">{{item.statusText}}</text></view>
    <view class="summary">{{item.summary}}</view>
    <view class="line label"><text>下单 {{item.timeText}}</text><text>实付 ¥{{item.totalText}}</text></view>
  </view>
</view>
<view wx:else class="empty">
  <image class="empty-img" src="/images/empty/content.png" mode="aspectFit" />
  <view>暂无预约，下单时可在“预约时间”中选择取餐时段</view>
  <button class="btn-red" bindtap="goMenu">去点单</button>
</view>
