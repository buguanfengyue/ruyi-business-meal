.hero { position: relative; height: 900rpx; background: #fff; }
.hero-art { height: 780rpx; border-radius: 0 0 28rpx 28rpx; background: linear-gradient(135deg, #5c3327, #e67e35 42%, #5d2720 43%, #f0bc75); position: relative; overflow: hidden; }
.hero-copy { position: absolute; top: 90rpx; left: 48rpx; color: #fff; display: flex; flex-direction: column; text-shadow: 0 4rpx 10rpx rgba(0,0,0,.5); }
.hero-name { font-size: 64rpx; font-weight: 700; }
.hero-sub { font-size: 36rpx; letter-spacing: 14rpx; margin-top: 8rpx; }
.hero-food { position: absolute; bottom: 120rpx; width: 100%; text-align: center; font-size: 130rpx; }
.account { position: absolute; left: 40rpx; right: 40rpx; bottom: 30rpx; height: 144rpx; background: #fff; border-radius: 14rpx; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.08); display: flex; align-items: center; font-size: 26rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin: 0 18rpx; background: linear-gradient(135deg, #e6b989, #d33d27); color: #fff; font-size: 44rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.account-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.metric { width: 130rpx; border-left: 1rpx solid #eee; text-align: center; }
.bold { font-weight: 700; }
.content { padding: 0 36rpx 40rpx; }
.error { color: #b42318; background: #fff1f0; margin-top: 20rpx; }
.delivery { margin-top: 20rpx; height: 200rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(0,0,0,.12); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.delivery-title { font-size: 56rpx; font-weight: 700; letter-spacing: 6rpx; }
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24rpx; margin-top: 24rpx; }
.feature { background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,.1); min-height: 190rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; font-size: 28rpx; }
.icon { font-size: 60rpx; line-height: 1; }
.tiny { font-size: 18rpx; color: #aaa; }
.banner { margin: 44rpx -36rpx 0; height: 240rpx; background: linear-gradient(120deg, #252a2f, #60656a 50%, #2b2524); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; font-size: 36rpx; }
.banner-title { font-size: 46rpx; font-weight: 800; letter-spacing: 4rpx; }
.tech { text-align: center; color: #aaa; font-size: 22rpx; padding: 50rpx 0; }
