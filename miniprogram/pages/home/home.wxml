<view class="hero">
  <view class="hero-art">
    <image class="hero-logo" src="/images/ui/logo.png" mode="aspectFit" />
    <view class="hero-copy"><text class="hero-name">如一</text><text class="hero-sub">商务餐</text></view>
  </view>
  <view class="account" bindtap="goMe">
    <image class="avatar" src="/images/ui/avatar-default.png" mode="aspectFill" />
    <view class="account-main"><view class="bold">{{user.registered ? user.nickname : (user ? '未授权' : '未登录')}}</view><view>{{phoneText}}</view></view>
    <view class="metric"><view class="bold">{{user.availableCoupons || 0}}</view><view>可用券</view></view>
  </view>
</view>

<view class="content">
  <view wx:if="{{error}}" class="card error" bindtap="load">{{error}}（点击重试）</view>
  <view class="delivery" bindtap="goMenu"><view class="delivery-title">外卖订餐</view><view class="muted">点餐配送</view></view>
  <view class="grid">
    <view class="feature" data-kind="wechat" bindtap="goInfo">
      <image class="icon-img" src="/images/ui/boss-wechat-qr.jpg" mode="aspectFill" />
      <text class="bold">老板微信</text>
    </view>
    <!-- open-type="share" 直接打开微信「选择发送给谁」面板 -->
    <button class="feature share-feature" open-type="share" data-share="invite">
      <image class="icon-img" src="/images/ui/invite.png" mode="aspectFit" />
      <text class="bold">推荐朋友</text>
      <text class="tiny">分享到微信</text>
    </button>
    <view class="feature" bindtap="callStore">
      <image class="icon-img" src="/images/ui/call-store.png" mode="aspectFit" />
      <text class="bold">订餐电话</text>
      <text class="tiny">{{store.phone}}</text>
    </view>
    <view class="feature" data-url="/pages/points/points" bindtap="goPage">
      <image class="icon-img" src="/images/ui/feature-points.png" mode="aspectFit" />
      <text class="bold">我的积分</text>
      <text class="tiny">POINTS</text>
    </view>
  </view>
  <view class="banner-wrap">
    <image class="banner-img" src="/images/ui/invite-banner.jpg" mode="aspectFill" />
    <button class="banner-share" open-type="share" data-share="invite">邀请好友</button>
    <view class="banner-link" bindtap="goInvitePage">查看邀请奖励 ›</view>
  </view>
</view>
