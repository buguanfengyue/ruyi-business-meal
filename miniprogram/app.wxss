page { background: #f6f6f6; color: #1b1b1b; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { border-radius: 8rpx; }
.page { padding: 24rpx; }
.card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.05); }
.brand { color: #d91e26; font-weight: 700; }
.muted { color: #999; }
.primary { background: #d91e26; color: #fff; }
